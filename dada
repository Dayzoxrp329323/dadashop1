import bcrypt from "bcryptjs";
import jwt from "jsonwebtoken";
import multer from "multer";
import fs from "fs";
dotenv.config();
const __dirname=path.dirname(fileURLToPath(import.meta.url)),app=express();
const db=new Database(path.join(__dirname,"dadashop.db"));
db.exec(`CREATE TABLE IF NOT EXISTS users(id INTEGER PRIMARY KEY AUTOINCREMENT,name TEXT,email TEXT UNIQUE,password TEXT,wallet INTEGER DEFAULT 0);
CREATE TABLE IF NOT EXISTS products(id INTEGER PRIMARY KEY AUTOINCREMENT,seller INTEGER,title TEXT,description TEXT,price INTEGER,category TEXT,image TEXT,sold INTEGER DEFAULT 0,created TEXT DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS orders(id INTEGER PRIMARY KEY AUTOINCREMENT,buyer INTEGER,seller INTEGER,product INTEGER,amount INTEGER,status TEXT DEFAULT 'paid',created TEXT DEFAULT CURRENT_TIMESTAMP);`);
fs.mkdirSync(path.join(__dirname,"public/uploads"),{recursive:true});
const upload=multer({dest:path.join(__dirname,"public/uploads")});
app.use(express.json());app.use(express.urlencoded({extended:true}));app.use(express.static(path.join(__dirname,"public")));
const secret=process.env.JWT_SECRET||"dadashop-dev-secret";
function auth(req,res,next){const t=(req.headers.authorization||"").replace("Bearer ","");try{req.user=jwt.verify(t,secret);next()}catch{res.status(401).json({error:"AUTH_REQUIRED"})}}
app.post("/api/register",async(req,res)=>{const {name,email,password}=req.body;if(!name||!email||!password||password.length<6)return res.status(400).json({error:"Informations invalides"});try{const p=await bcrypt.hash(password,12),r=db.prepare("INSERT INTO users(name,email,password) VALUES(?,?,?)").run(name,email.toLowerCase(),p),u={id:+r.lastInsertRowid,name,email:email.toLowerCase()};res.json({token:jwt.sign(u,secret,{expiresIn:"7d"}),user:u})}catch{res.status(400).json({error:"Email déjà utilisé"})}});
app.post("/api/login",async(req,res)=>{const u=db.prepare("SELECT * FROM users WHERE email=?").get((req.body.email||"").toLowerCase());if(!u||!(await bcrypt.compare(req.body.password||"",u.password)))return res.status(401).json({error:"Email ou mot de passe incorrect"});const x={id:u.id,name:u.name,email:u.email};res.json({token:jwt.sign(x,secret,{expiresIn:"7d"}),user:x})});
app.get("/api/me",auth,(req,res)=>res.json(db.prepare("SELECT id,name,email,wallet FROM users WHERE id=?").get(req.user.id)));
app.get("/api/products",(req,res)=>{const q=(req.query.q||"").trim();const a=q?db.prepare("SELECT p.*,u.name seller FROM products p JOIN users u ON u.id=p.seller WHERE p.sold=0 AND (p.title LIKE ? OR p.description LIKE ?) ORDER BY p.id DESC").all("%"+q+"%","%"+q+"%"):db.prepare("SELECT p.*,u.name seller FROM products p JOIN users u ON u.id=p.seller WHERE p.sold=0 ORDER BY p.id DESC").all();res.json(a)});
app.post("/api/products",auth,upload.single("image"),(req,res)=>{const c=Number(req.body.price)*100;if(!req.body.title||!req.body.description||!Number.isFinite(c)||c<=0)return res.status(400).json({error:"Annonce invalide"});const img=req.file?"/uploads/"+req.file.filename:"";const r=db.prepare("INSERT INTO products(seller,title,description,price,category,image) VALUES(?,?,?,?,?,?)").run(req.user.id,req.body.title,req.body.description,Math.round(c),req.body.category||"Autre",img);res.json({id:+r.lastInsertRowid})});
app.post("/api/buy/:id",auth,(req,res)=>{const p=db.prepare("SELECT * FROM products WHERE id=? AND sold=0").get(req.params.id),b=db.prepare("SELECT * FROM users WHERE id=?").get(req.user.id);if(!p)return res.status(404).json({error:"Article indisponible"});if(p.seller===b.id)return res.status(400).json({error:"Impossible d'acheter sa propre annonce"});if(b.wallet<p.price)return res.status(402).json({error:"Solde insuffisant"});const tx=db.transaction(()=>{db.prepare("UPDATE users SET wallet=wallet-? WHERE id=?").run(p.price,b.id);db.prepare("UPDATE users SET wallet=wallet+? WHERE id=?").run(p.price,p.seller);db.prepare("UPDATE products SET sold=1 WHERE id=?").run(p.id);return db.prepare("INSERT INTO orders(buyer,seller,product,amount) VALUES(?,?,?,?)").run(b.id,p.seller,p.id,p.price)});const r=tx();res.json({ok:true,order:+r.lastInsertRowid})});
app.get("/api/orders",auth,(req,res)=>res.json(db.prepare("SELECT o.*,p.title,p.image FROM orders o JOIN products p ON p.id=o.product WHERE o.buyer=? ORDER BY o.id DESC").all(req.user.id)));
app.post("/api/wallet/demo",auth,(req,res)=>{const n=Math.round(Number(req.body.amount)*100);if(n<=0||n>10000000)return res.status(400).json({error:"Montant invalide"});db.prepare("UPDATE users SET wallet=wallet+? WHERE id=?").run(n,req.user.id);res.json({ok:true})});
app.get("*",(req,res)=>res.sendFile(path.join(__dirname,"public/index.html")));
app.listen(process.env.PORT||3000,()=>console.log("DadaShop lancé"));
