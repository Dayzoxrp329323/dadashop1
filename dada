"public/app.js":'''let token=localStorage.getItem("dada_token")||"",reg=false,lang=localStorage.getItem("dada_lang")||"fr";const $=x=>document.getElementById(x);const euro=c=>new Intl.NumberFormat(lang==="ru"?"ru-RU":lang==="az"?"az-AZ":"fr-FR",{style:"currency",currency:"EUR"}).format(c/100);
async function api(u,o={}){o.headers=o.headers||{};if(token)o.headers.Authorization="Bearer "+token;let r=await fetch(u,o),d=await r.json().catch(()=>({}));if(!r.ok)throw Error(d.error||"Erreur");return d}
function page(id){document.querySelectorAll(".page").forEach(x=>x.classList.remove("active"));$(id).classList.add("active");if(id==="orders")orders();if(id==="wallet")me();if(id==="sell"&&!token)auth()}
function toast(t){$("toast").textContent=t;$("toast").style.display="block";setTimeout(()=>$("toast").style.display="none",2300)}
function safe(s){return String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
async function load(){let q=encodeURIComponent($("q").value),p=await api("/api/products?q="+q);let html=p.map(x=>`<article class="product"><img src="${x.image||"https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=700&q=80"}"><div class="body"><div class="price">${euro(x.price)}</div><h3>${safe(x.title)}</h3><div class="muted">${safe(x.category)} · ${safe(x.seller)}</div><button class="cta buy" onclick="buy(${x.id})">Acheter</button></div></article>`).join("");$("products").innerHTML=html||"<p>Aucune annonce.</p>";$("products2").innerHTML=html||"<p>Aucune annonce.</p>"}
function auth(){$("modal").classList.remove("hide")}
function closeAuth(){$("modal").classList.add("hide")}
function toggle(){reg=!reg;$("authTitle").textContent=reg?"Créer ton compte":"Bienvenue";$("name").style.display=reg?"block":"none";$("switch").innerHTML=reg?'Déjà un compte ? <a onclick="toggle()">Se connecter</a>':'Pas encore de compte ? <a onclick="toggle()">Créer un compte</a>'}
$("authForm").onsubmit=async e=>{e.preventDefault();try{let b={email:$("email").value,password:$("pass").value};if(reg)b.name=$("name").value;let d=await api(reg?"/api/register":"/api/login",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(b)});token=d.token;localStorage.setItem("dada_token",token);closeAuth();$("account").textContent="Mon compte";toast("Connexion réussie");me()}catch(e){$("msg").textContent=e.message}}
$("sellForm").onsubmit=async e=>{e.preventDefault();if(!token)return auth();try{let r=await fetch("/api/products",{method:"POST",headers:{Authorization:"Bearer "+token},body:new FormData(e.target)}),d=await r.json();if(!r.ok)throw Error(d.error);e.target.reset();toast("Annonce publiée");page("home");load()}catch(x){toast(x.message)}}
async function buy(id){if(!token)return auth();try{let d=await api("/api/buy/"+id,{method:"POST"});toast("Achat confirmé #"+d.order);load();orders()}catch(e){toast(e.message)}}
async function me(){if(!token)return;try{let u=await api("/api/me");$("bal").textContent=euro(u.wallet)}catch{}}
async function orders(){if(!token){$("ordersList").innerHTML="<p>Connecte-toi pour voir tes commandes.</p>";return}let a=await api("/api/orders");$("ordersList").innerHTML=a.length?a.map(o=>`<div class="order"><b>${safe(o.title)}</b><br>${euro(o.amount)} · ${safe(o.status)}</div>`).join(""):"<p>Aucune commande.</p>"}
$("credit").onsubmit=async e=>{e.preventDefault();try{await api("/api/wallet/demo",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({amount:e.target.amount.value})});e.target.reset();me();toast("Portefeuille mis à jour")}catch(x){toast(x.message)}}
function cycleLang(){lang=lang==="fr"?"ru":lang==="ru"?"az":"fr";localStorage.setItem("dada_lang",lang);$("lang").textContent=lang.toUpperCase();toast(lang==="ru"?"Русский":lang==="az"?"Azərbaycan":"Français")}
$("lang").textContent=lang.toUpperCase();if(token)$("account").textContent="Mon compte";load();if(token)me();''',
