:relative}.fashion{position:absolute;inset:35px 15px 10px;background:linear-gradient(145deg,#f9f7f2,#d9c7ff);border-radius:28px;box-shadow:0 25px 45px #0002}.floating,.priceTag{position:absolute;background:#fff;padding:12px 16px;border-radius:13px;box-shadow:0 10px 25px #0002;font-weight:700}.f1{top:20px;right:0}.priceTag{bottom:0;left:0}.sectionHead{display:flex;justify-content:space-between;align-items:end;margin:42px 0 18px}.sectionHead h2{font-size:30px;margin:5px 0}.sectionHead button{border:0;background:none;font-weight:800}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.product{background:#fff;border:1px solid var(--line);border-radius:19px;overflow:hidden;transition:.2s}.product:hover{transform:translateY(-3px);box-shadow:0 15px 35px #0000000d}.product img{width:100%;aspect-ratio:1;object-fit:cover;background:#eee}.body{padding:14px}.price{font-weight:800;font-size:18px}.body h3{margin:7px 0;font-size:15px}.muted{font-size:12px;color:var(--muted)}.buy{margin-top:10px;width:100%;background:var(--purple)}.panel{max-width:720px;margin:30px auto;background:#fff;border:1px solid var(--line);border-radius:25px;padding:30px}.panel h2{font-size:35px;margin:6px 0 25px}.panel form{display:grid;gap:13px}input,textarea,select{font:inherit;padding:14px;border:1px solid var(--line);border-radius:12px;width:100%}textarea{min-height:140px}.row{display:grid;grid-template-columns:1fr 1fr;gap:13px}.wallet #bal{font-size:55px;font-weight:800;margin-top:25px}.notice{margin-top:25px;padding:15px;background:#f4f0ff;border-radius:13px;font-size:13px}.modal{position:fixed;inset:0;background:#0008;display:grid;place-items:center;z-index:20}.hide{display:none}.modalBox{width:min(430px,92%);background:#fff;border-radius:24px;padding:30px;position:relative}.modalBox form{display:grid;gap:12px}.modalBox a{color:var(--purple);font-weight:800;cursor:pointer}.x{position:absolute;right:15px;top:12px;border:0;background:none;font-size:28px}.hideInput{display:none}#toast{posit